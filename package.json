{
  "name": "emdash-admin-theme-classic",
  "version": "0.3.3",
  "description": "wp-admin look for the EmDash CMS admin panel. Two layers: design tokens on their own, or tokens plus geometry. CSS only, no core patching.",
  "keywords": [
    "emdash",
    "emdash-cms",
    "emdash-admin-theme",
    "admin",
    "admin-theme",
    "wordpress",
    "wp-admin"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./middleware": "./src/middleware.ts",
    "./middleware-configured": "./src/middleware-configured.ts",
    "./inject": "./src/inject.ts",
    "./tokens.css": "./src/tokens.css",
    "./skin.css": "./src/skin.css",
    "./package.json": "./package.json",
    "./serve": "./src/serve.ts"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "astro": "^7.0.0",
    "emdash": ">=0.36.0 <1.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@emdash-cms/admin": "1.2.0",
    "astro": "^7.3.1",
    "emdash": "1.2.0",
    "playwright": "1.61.1",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "astro sync && tsc --noEmit",
    "surface": "node scripts/surface.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marks-zyz/emdash-admin-theme-classic.git"
  },
  "bugs": {
    "url": "https://github.com/marks-zyz/emdash-admin-theme-classic/issues"
  },
  "homepage": "https://github.com/marks-zyz/emdash-admin-theme-classic#readme"
}
